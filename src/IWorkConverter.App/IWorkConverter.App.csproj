<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
	  <!-- 単一ファイルとして出力する -->
	  <PublishSingleFile>true</PublishSingleFile>
	  <!-- 単一ファイルを圧縮してファイルサイズを削減する -->
	  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	  <!-- ネイティブDLLを一時フォルダに自己展開して読み込めるようにする -->
	  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	  <!-- 【重要】ランタイムを含める（自己完結型）にする設定 -->
	  <SelfContained>true</SelfContained>
	  <!-- 【重要】対象のOSとアーキテクチャを指定（例: Windows 64bit） -->
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>IWorkConverter.App</RootNamespace>
    <AssemblyName>iWorkConverter</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IWorkConverter.Core\IWorkConverter.Core.csproj" />
  </ItemGroup>

</Project>
